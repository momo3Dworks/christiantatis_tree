
/**
 * @file Firestore Security Rules
 * @description This ruleset governs access to the `home_churches` collection.
 *
 * Core Philosophy:
 * The security model ensures that users can only manage their own data while allowing
 * public read access for discoverability. Data validation is enforced at the rule level
 * to ensure data integrity and prevent malicious inputs.
 *
 * Data Structure:
 * All home church data is stored in the top-level `/home_churches/{homeChurchId}` collection.
 * Each document contains a `creatorId` field, which is essential for ownership-based security.
 *
 * Key Security Decisions:
 * - Listing of home churches is open to all users (including unauthenticated).
 * - Only authenticated users can create home church documents.
 * - During creation, the `creatorId` must match the UID of the user making the request, and incoming data must be of the correct type.
 * - Updates are restricted to the owner for most fields, with strict data type validation.
 * - Any signed-in user can update only the 'reservations' field to add or remove themselves.
 * - Deletions are restricted to the document owner.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the `/home_churches` collection.
     * @path /home_churches/{homeChurchId}
     * @allow (get, list) Allow any user to read home church data for discoverability.
     * @allow (create) Allow authenticated users to create a church, but only if they set themselves as the creator and data is valid.
     * @allow (update) Allow owner to update their church with valid data, or any user to reserve/cancel a spot.
     * @allow (delete) Allow users to delete a church only if they are the original creator.
     * @principle Owner-write, public-read, user-self-reservation, strict-validation.
     */
    match /home_churches/{homeChurchId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn() 
                      && isOwner(request.resource.data)
                      && isValidHomeChurchData(request.resource.data);
      
      allow update: if isSignedIn() && (
                      (isOwner(resource.data) && isNotModifyingReservations() && isValidHomeChurchData(request.resource.data)) || 
                      isManagingOwnReservation()
                    );
                    
      allow delete: if isSignedIn() && isOwner(resource.data);
    }

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is the owner of the document
    function isOwner(docData) {
        return docData.creatorId == request.auth.uid;
    }

    // Helper to validate the data for a HomeChurch document
    function isValidHomeChurchData(data) {
      return data.name is string && data.name.size() > 1
          && data.phoneNumber is string && data.phoneNumber.size() > 9
          && (data.email == null || (data.email is string && data.email.matches('.*@.*\\..*')))
          && (data.websiteUrl == null || (data.websiteUrl is string && data.websiteUrl.matches('https?://.*')))
          && (data.neighborhood == null || data.neighborhood is string)
          && (data.personLimit == null || data.personLimit is number)
          && data.status is string
          && data.meetingSchedule is string
          && data.meetingDate is timestamp
          && data.isRecurring is bool
          && data.latitude is number
          && data.longitude is number
          && data.creatorId == request.auth.uid; // Ensure creatorId is always the current user
    }

    // Helper to ensure that only the owner can modify fields other than 'reservations'
    function isNotModifyingReservations() {
      return !('reservations' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // Helper function to check if the user is only adding or removing themselves from the reservations list.
    function isManagingOwnReservation() {
      // Ensure only the 'reservations' field is being modified.
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      if (!affectedKeys.hasOnly(['reservations'])) {
        return false;
      }

      // Check if the user is adding themselves
      let isAddingSelf = request.resource.data.reservations.hasAny([request.auth.uid]) &&
                         !resource.data.reservations.hasAny([request.auth.uid]);
                         
      // Check if the user is removing themselves
      let isRemovingSelf = !request.resource.data.reservations.hasAny([request.auth.uid]) &&
                           resource.data.reservations.hasAny([request.auth.uid]);

      // The entire change must be either adding themselves or removing themselves, and nothing else.
      let newReservations = request.resource.data.reservations;
      let oldReservations = resource.data.reservations;

      // When adding, the new list must be the old list plus the user's UID.
      if (isAddingSelf) {
        return newReservations.size() == oldReservations.size() + 1;
      }
      
      // When removing, the new list must be the old list minus the user's UID.
      if (isRemovingSelf) {
        return newReservations.size() == oldReservations.size() - 1;
      }
      
      return false;
    }
  }
}
